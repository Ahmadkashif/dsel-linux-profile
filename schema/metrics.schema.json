            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Attempt"
        },
        "cell": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Run-matrix cell this record belongs to.",
          "title": "Cell"
        },
        "engine": {
          "title": "Engine",
          "type": "string"
        },
        "errno": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Errno"
        },
        "event": {
          "enum": [
            "opened",
            "refused",
            "reset",
            "closed",
            "timeout"
          ],
          "title": "Event",
          "type": "string"
        },
        "kind": {
          "const": "connection_event",
          "default": "connection_event",
          "title": "Kind",
          "type": "string"
        },
        "message": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Message"
