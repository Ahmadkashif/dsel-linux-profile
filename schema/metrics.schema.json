    "ConnectionEventRecord": {
      "additionalProperties": false,
      "description": "One thing that happened to a connection: opened, refused, reset, closed.\n\nCarries the *evidence* and not the explanation. The SQLSTATE and the\nserver's own message go in; naming the mechanism -- `max_connections`,\nan idle-in-transaction timeout, ephemeral port exhaustion -- is derivation\nand belongs in `phenomena/conn_lifecycle.py`, from the file. A sampler that\nwrote its own conclusion would make the conclusion unreviewable.",
      "properties": {
        "age_s": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Age S"
        },
        "attempt": {
          "anyOf": [
