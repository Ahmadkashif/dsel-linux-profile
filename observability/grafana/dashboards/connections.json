      "options": {},
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "dsel-prometheus"
          },
          "expr": "dsbench_net_ephemeral_ports",
          "legendFormat": "{{scope}} {{kind}}"
        }
      ]
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "mean backend RSS",
      "description": "Per-backend memory growth is what turns a connection count into a memory limit.",
      "datasource": {
        "type": "prometheus",
        "uid": "dsel-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 32
      },
      "fieldConfig": {
        "defaults": {
          "custom": {},
          "unit": "bytes"
        },
        "overrides": []
      },
      "options": {},
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "dsel-prometheus"
          },
          "expr": "dsbench_backend_rss_bytes_sum / dsbench_backend_rss_bytes_count",
          "legendFormat": "{{engine}}"
        }
      ]
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "pool timeouts",
