{
  "uid": "dsel-now",
  "title": "dsel — now",
  "description": "The live view: throughput, latency estimates, phase and envelope pressure.",
  "tags": [
    "dsel"
  ],
  "timezone": "utc",
  "editable": false,
  "schemaVersion": 39,
  "version": 1,
  "refresh": "5s",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "throughput",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "dsel-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "custom": {},
          "unit": "ops"
        },
        "overrides": []
      },
      "options": {},
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "dsel-prometheus"
          },
          "expr": "sum(dsbench_op_rate_per_second)",
          "legendFormat": "total"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "dsel-prometheus"
          },
          "expr": "dsbench_op_rate_per_second",
          "legendFormat": "{{op}}"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "operation latency p50/p99 — within-window estimate, not the reported figure",
      "description": "WITHIN-WINDOW ESTIMATE, not the reported figure. The HdrHistogram .hlog written into the audit bundle is authoritative; a scrape bucket must never become a reported percentile.",
      "datasource": {
        "type": "prometheus",
        "uid": "dsel-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "custom": {},
          "unit": "µs"
        },
        "overrides": []
      },
      "options": {},
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "dsel-prometheus"
          },
          "expr": "dsbench_op_latency_estimate_microseconds{quantile=\"p50\"}",
          "legendFormat": "{{op}} p50"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "dsel-prometheus"
          },
          "expr": "dsbench_op_latency_estimate_microseconds{quantile=\"p99\"}",
          "legendFormat": "{{op}} p99"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "errors",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "dsel-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "fieldConfig": {
        "defaults": {
          "custom": {}
        },
        "overrides": []
      },
      "options": {},
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "dsel-prometheus"
          },
          "expr": "dsbench_op_errors_total",
          "legendFormat": "{{op}}"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "phase",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "dsel-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 8
      },
      "fieldConfig": {
        "defaults": {
          "custom": {}
        },
        "overrides": []
      },
      "options": {},
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "dsel-prometheus"
          },
          "expr": "dsbench_phase_active",
          "legendFormat": "active {{phase}}"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "dsel-prometheus"
          },
          "expr": "dsbench_phase_completed",
          "legendFormat": "done {{phase}}"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "engine CPU throttling",
      "description": "Throttling above zero means the quota is binding, not that the engine is slow.",
      "datasource": {
        "type": "prometheus",
        "uid": "dsel-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 16
      },
      "fieldConfig": {
        "defaults": {
          "custom": {}
        },
        "overrides": []
      },
      "options": {},
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "dsel-prometheus"
          },
          "expr": "rate(dsbench_container_cpu_throttled_microseconds_total[1m])",
          "legendFormat": "{{container}}"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "memory against the envelope",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "dsel-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 16
      },
      "fieldConfig": {
        "defaults": {
          "custom": {},
          "unit": "percentunit"
        },
        "overrides": []
      },
      "options": {},
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "dsel-prometheus"
          },
          "expr": "dsbench_container_memory_bytes / dsbench_container_memory_limit_bytes",
          "legendFormat": "{{container}}"
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "throughput carrying step and repeat",
      "description": "step and repeat join from dsbench_cell_info rather than being labels on every series; carrying them everywhere would multiply the whole metric set by the length of a ramp.",
      "datasource": {
        "type": "prometheus",
        "uid": "dsel-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 24
      },
      "fieldConfig": {
        "defaults": {
          "custom": {}
        },
        "overrides": []
      },
      "options": {},
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "dsel-prometheus"
          },
          "expr": "dsbench_op_rate_per_second * on() group_left(step, repeat, engine, scenario) dsbench_cell_info",
          "legendFormat": "{{op}} step {{step}} rep {{repeat}}"
        }
      ]
    },
    {
      "id": 8,
      "type": "table",
      "title": "cell",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "dsel-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 24
      },
      "fieldConfig": {
        "defaults": {
          "custom": {}
        },
        "overrides": []
      },
      "options": {},
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "dsel-prometheus"
          },
          "expr": "dsbench_cell_info",
          "legendFormat": "{{cell}}"
        }
      ]
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "series budget",
      "description": "An active count under the cap only means something beside a refused count of zero: admission control keeps the first number honest by making the second non-zero instead.",
      "datasource": {
        "type": "prometheus",
        "uid": "dsel-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 32
      },
      "fieldConfig": {
        "defaults": {
          "custom": {}
        },
        "overrides": []
      },
      "options": {},
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "dsel-prometheus"
          },
          "expr": "dsbench_series_active",
          "legendFormat": "active"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "dsel-prometheus"
          },
          "expr": "dsbench_series_budget_active_limit",
          "legendFormat": "cap"
        },
        {
          "refId": "C",
          "datasource": {
            "type": "prometheus",
            "uid": "dsel-prometheus"
          },
          "expr": "dsbench_series_refused_total",
          "legendFormat": "refused"
        }
      ]
    }
  ]
}
