=== compose config (does it validate + what does it resolve to?) ===
name: dsa-exp02
services:
  valkey:
    cpuset: 0-1
    command:
      - valkey-server
      - --save
      - ""
      - --appendonly
      - 'no'
      - --maxmemory
      - 512mb
      - --maxmemory-policy
      - noeviction
      - --io-threads
      - "2"
    deploy:
      resources:
        limits:
          cpus: 2
          memory: "2147483648"
          pids: 512
        reservations:
          cpus: 1
          memory: "1073741824"
    healthcheck:
      test:
        - CMD
        - valkey-cli
        - ping
      timeout: 3s
      interval: 1s
      retries: 60
      start_period: 1s
    image: valkey/valkey@sha256:a174b894902bd3367e330d47cc2054367dc4917701776aaf336f41d83b65ec7a
    networks:
      default: null
    ports:
      - mode: ingress
        target: 6379

